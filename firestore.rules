rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: profiles
// Document ID: {profileKey} (deterministic lowercase slug + PIN code, 3..80 chars, e.g. "yusif_1234")
// Fields:
//   - displayName: string (required, 1..60 chars) - Student/teacher display name
//   - pin: string (required, 4..12 chars, immutable on update) - Profile PIN code/hash
//   - userAnswers: map (optional, <= 5000 entries) - Saved answers keyed by variant/question
//   - quizProgress: map (optional, <= 500 entries) - Last question index, status, and timestamp per quiz variant
//   - fcStatus: map (optional, <= 5000 entries) - Flashcard mastery statuses
//   - examHistory: list (optional, <= 500 items) - Completed exam attempts
//   - lastActiveQuiz: map or null (optional, keys: variant, mode, index, title, updatedAt) - Last active quiz session metadata
//   - updatedAt: string or timestamp (optional, string <= 64 chars) - Last sync timestamp
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated (kept as standard helper)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource (kept as standard helper)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify UID hasn't been tampered with on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Ensure uid field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate string length
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate that the document hasn't changed in immutable fields
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Validate deterministic profileKey document ID bounds
    function isValidProfileKey(profileKey) {
      return profileKey is string &&
        profileKey.size() >= 3 &&
        profileKey.size() <= 80;
    }

    // Validate optional lastActiveQuiz map or null
    function isValidLastActiveQuiz(data) {
      return !('lastActiveQuiz' in data) ||
        data.lastActiveQuiz == null ||
        (data.lastActiveQuiz is map &&
          data.lastActiveQuiz.keys().hasOnly(['variant', 'mode', 'index', 'title', 'updatedAt']) &&
          (!('variant' in data.lastActiveQuiz) || (data.lastActiveQuiz.variant is string && data.lastActiveQuiz.variant.size() <= 120)) &&
          (!('mode' in data.lastActiveQuiz) || (data.lastActiveQuiz.mode is string && data.lastActiveQuiz.mode.size() <= 40)) &&
          (!('index' in data.lastActiveQuiz) || (data.lastActiveQuiz.index is int && data.lastActiveQuiz.index >= 0 && data.lastActiveQuiz.index <= 10000)) &&
          (!('title' in data.lastActiveQuiz) || (data.lastActiveQuiz.title is string && data.lastActiveQuiz.title.size() <= 200)) &&
          (!('updatedAt' in data.lastActiveQuiz) || (data.lastActiveQuiz.updatedAt is string && data.lastActiveQuiz.updatedAt.size() <= 64) || data.lastActiveQuiz.updatedAt is timestamp || data.lastActiveQuiz.updatedAt is int));
    }

    // ===============================================================
    // Domain Validators (Used in both create and update)
    // ===============================================================

    function isValidProfile(profileKey, data) {
      return isValidProfileKey(profileKey) &&
        hasOnlyAllowedFields([
          'displayName',
          'pin',
          'userAnswers',
          'quizProgress',
          'fcStatus',
          'examHistory',
          'lastActiveQuiz',
          'updatedAt'
        ]) &&
        hasRequiredFields(['displayName', 'pin']) &&
        validStringLength('displayName', 1, 60) &&
        validStringLength('pin', 4, 12) &&
        (!('userAnswers' in data) || (data.userAnswers is map && data.userAnswers.size() <= 5000)) &&
        (!('quizProgress' in data) || (data.quizProgress is map && data.quizProgress.size() <= 500)) &&
        (!('fcStatus' in data) || (data.fcStatus is map && data.fcStatus.size() <= 5000)) &&
        (!('examHistory' in data) || (data.examHistory is list && data.examHistory.size() <= 500)) &&
        isValidLastActiveQuiz(data) &&
        (!('updatedAt' in data) ||
          (data.updatedAt is string && data.updatedAt.size() <= 64) ||
          data.updatedAt is timestamp);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /profiles/{profileKey} {
      // Allow direct document lookup by known profileKey (slug + PIN); disallow enumeration
      allow get: if isValidProfileKey(profileKey);
      allow list: if false;

      // Allow creating and updating valid study profiles; PIN is immutable once created
      allow create: if isValidProfile(profileKey, request.resource.data);
      allow update: if isValidProfile(profileKey, request.resource.data) &&
        areImmutableFieldsUnchanged(['pin']);

      // Disallow deleting profiles
      allow delete: if false;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
